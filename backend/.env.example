# BlackBox Backend Environment Variables (Local Development Template)
# Copy this to .env and fill in real values. NEVER commit .env

# ── Nebius Token Factory / NVIDIA Open Models ──────────────────────────
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# ── Database (Neon PostgreSQL in prod or SQLite in local dev) ───────────
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./blackbox.db
# Neon PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# ── Durable Object Storage (Cloudflare R2) ─────────────────────────────
# Local development default:
STORAGE_BACKEND=local
# Cloudflare R2 in production:
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=blackbox-artifacts
# R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com

# ── Background Job Queue (Upstash Redis) ────────────────────────────────
# In-process queue default for local development. Set for Upstash:
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ── Application Configuration ───────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
BLACKBOX_WORKSPACE_ROOT=./workspace_data
