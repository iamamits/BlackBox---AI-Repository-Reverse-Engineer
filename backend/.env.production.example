# BlackBox Production Environment Template
# Copy this to .env.production on your deployment server. NEVER commit real secrets to Git.

# ── Nebius Token Factory / NVIDIA Open Models ──────────────────────────
NEBIUS_API_KEY=<your-production-nebius-api-key>
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# ── Neon Managed PostgreSQL (Production Database) ───────────────────────
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>/<database>?ssl=require

# ── Cloudflare R2 Durable Object Storage ───────────────────────────────
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-private-bucket-name>
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com

# ── Upstash Serverless Redis (Queue & Job Coordination) ─────────────────
REDIS_URL=rediss://default:<upstash-password>@<upstash-endpoint>.upstash.io:6379

# ── Application Environment ─────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://blackbox.yourdomain.com
BLACKBOX_WORKSPACE_ROOT=/app/workspace_data
